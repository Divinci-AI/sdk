---
/**
 * Thin Starlight shell around @divinci-ai/embed-chat-ui — the open-source
 * "Ask Divinci" widget. Generated by Divinci Docs; the widget itself (markup,
 * styles, behavior) lives in the package. This component only passes build-time
 * config and maps Starlight theme tokens → the widget's --divinci-* tokens.
 *
 *   PUBLIC_DIVINCI_API_URL     — api host (default https://api.divinci.app)
 *   PUBLIC_DIVINCI_RELEASE_ID  — this project's Release id
 * releaseId unset → nothing mounts.
 */
const releaseId = import.meta.env.PUBLIC_DIVINCI_RELEASE_ID || "";
const apiUrl = import.meta.env.PUBLIC_DIVINCI_API_URL || "https://api.divinci.app";
const enabled = Boolean(releaseId);
---

{
  enabled && (
    <div id="divinci-docs-config" data-release-id={releaseId} data-api-url={apiUrl} hidden />
  )
}

<style is:global>
  /* Map Starlight theme tokens → the widget's --divinci-* tokens so the
     assistant tracks the site's light/dark theme. */
  #divinci-docs-assistant {
    --divinci-color-accent: var(--sl-color-accent);
    --divinci-color-accent-high: var(--sl-color-accent-high);
    --divinci-color-bg: var(--sl-color-bg);
    --divinci-color-black: var(--sl-color-black);
    --divinci-color-white: var(--sl-color-white);
    --divinci-color-gray-2: var(--sl-color-gray-2);
    --divinci-color-gray-3: var(--sl-color-gray-3);
    --divinci-color-gray-4: var(--sl-color-gray-4);
    --divinci-color-gray-5: var(--sl-color-gray-5);
    --divinci-color-gray-6: var(--sl-color-gray-6);
    --divinci-color-gray-7: var(--sl-color-gray-7);
    --divinci-font: var(--sl-font);
    --divinci-font-mono: var(--sl-font-mono);
    --divinci-text-base: var(--sl-text-base);
    --divinci-text-sm: var(--sl-text-sm);
    --divinci-text-xs: var(--sl-text-xs);
    --divinci-shadow-md: var(--sl-shadow-md);
    --divinci-shadow-lg: var(--sl-shadow-lg);
    --divinci-nav-height: var(--sl-nav-height);
    --divinci-sidebar-width: var(--sl-sidebar-width);
  }
</style>

<script>
  import { mount } from "@divinci-ai/embed-chat-ui";

  const cfg = document.getElementById("divinci-docs-config");
  if (cfg) {
    const releaseId = cfg.dataset.releaseId || "";
    const apiUrl = cfg.dataset.apiUrl || "https://api.divinci.app";
    cfg.remove();
    if (releaseId) {
      mount(document.body, {
        releaseId,
        apiUrl,
        title: "__DIVINCI_ASSISTANT_TITLE__",
        launcherLabel: "__DIVINCI_ASSISTANT_TITLE__",
        greeting: "__DIVINCI_GREETING__",
        placeholder: "__DIVINCI_PLACEHOLDER__",
        app: {
          // The generator points these at the project's own app, if any.
          webAppUrl: "__DIVINCI_WEBAPP_URL__",
        },
      });
    }
  }
</script>
