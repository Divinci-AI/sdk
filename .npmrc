# Registry configuration
@divinci-ai:registry=https://registry.npmjs.org

# Authentication: deliberately ABSENT.
#
# This file used to carry //registry.npmjs.org/:_authToken=${NPM_TOKEN}.
# CI now publishes via Trusted Publishing (OIDC) and sets no NPM_TOKEN, so
# that line would expand to an empty or literal value — and npm tries a
# supplied token BEFORE attempting the OIDC exchange, so a broken token here
# silently disables Trusted Publishing and surfaces as a 401.
#
# Local publishing (scripts/publish-all.sh) authenticates through `npm login`
# and the user-level ~/.npmrc, which this file does not need to touch.

# Public access for scoped packages
access=public

# Strict peer dependencies
strict-peer-dependencies=false

# Auto-install peers
auto-install-peers=true
