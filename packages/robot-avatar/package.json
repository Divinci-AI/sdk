{
  "name": "@divinci-ai/robot-avatar",
  "version": "0.1.3",
  "description": "The Divinci robot mascot — procedural react-three-fiber avatar shared by the SDK docs hero, the web app, the Divinci Agent panel, and the Chrome extension.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "default": "./dist/scene/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "prepack": "node ../../scripts/assert-packed-deps.mjs"
  },
  "peerDependencies": {
    "@react-three/drei": ">=9.114.0",
    "@react-three/fiber": ">=8.17.0",
    "react": ">=18.3.0",
    "three": ">=0.169.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/react": "^19.2.17",
    "@types/three": "^0.185.0",
    "react": "^19.2.7",
    "three": "^0.185.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Divinci-AI/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Divinci-AI/sdk/issues"
  },
  "license": "MIT",
  "homepage": "https://sdk.divinci.ai"
}
