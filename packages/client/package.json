{
  "name": "@divinci-ai/client",
  "version": "0.6.6",
  "description": "Divinci AI Client SDK for browser applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "import": "./dist/chat/index.js",
      "default": "./dist/chat/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/assert-packed-deps.mjs && node ../../scripts/assert-version-honesty.mjs",
    "build": "tsc -b",
    "prepare": "tsc -b",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@divinci-ai/types": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "msw": "^2.12.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "divinci",
    "ai",
    "sdk",
    "client",
    "chat",
    "llm"
  ],
  "author": "Divinci AI <engineering@divinci.app>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Divinci-AI/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Divinci-AI/sdk/issues"
  },
  "homepage": "https://sdk.divinci.ai/client",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
