{
  "name": "@divinci-ai/mcp",
  "version": "0.1.7",
  "description": "Divinci AI MCP (Model Context Protocol) SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build",
    "prepack": "node ../../scripts/assert-packed-deps.mjs"
  },
  "dependencies": {
    "@divinci-ai/types": "workspace:*"
  },
  "devDependencies": {
    "@peculiar/webcrypto": "^2.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "msw": "^3.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "divinci",
    "ai",
    "sdk",
    "mcp",
    "model-context-protocol",
    "anthropic"
  ],
  "author": "Divinci AI <engineering@divinci.app>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Divinci-AI/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Divinci-AI/sdk/issues"
  },
  "homepage": "https://sdk.divinci.ai/mcp",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
